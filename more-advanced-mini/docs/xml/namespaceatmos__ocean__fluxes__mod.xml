        <argsstring>(gas_fluxes, gas_fields_atm, gas_fields_ice, verbosity, use_r4_kind)</argsstring>
        <name>atmos_ocean_fluxes_init</name>
        <param>
          <type>gas_fluxes</type>
          <defname>gas_fluxes</defname>
        </param>
        <param>
