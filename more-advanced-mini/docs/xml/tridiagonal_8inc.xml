        <definition>subroutine tri_invert_</definition>
        <argsstring>(x, d, a, b, c, store_both_kinds)</argsstring>
        <name>tri_invert_</name>
        <param>
          <type>x</type>
          <defname>x</defname>
        </param>
        <param>
          <type>d</type>
          <defname>d</defname>
        </param>
        <param>
          <type>a</type>
