        <argsstring>(string, string_array, index)</argsstring>
        <name>string_array_index</name>
        <param>
          <type>string</type>
          <defname>string</defname>
        </param>
        <param>
          <type>string_array</type>
          <defname>string_array</defname>
        </param>
        <param>
          <type>index</type>
          <defname>index</defname>
