        <type>subroutine</type>
        <definition>subroutine gaussian_topog_init_</definition>
        <argsstring>(lon, lat, zsurf)</argsstring>
        <name>gaussian_topog_init_</name>
        <param>
          <type>lon</type>
          <defname>lon</defname>
        </param>
        <param>
          <type>lat</type>
          <defname>lat</defname>
        </param>
        <param>
          <type>zsurf</type>
          <defname>zsurf</defname>
        </param>
        <briefdescription>
<para>Returns a simple surface height field that consists of a single Gaussian-shaped mountain. </para>        </briefdescription>
        <detaileddescription>
<para>Returns a surface height field that consists of the sum of one or more Gaussian-shaped mountains.</para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">lon</parametername>
</parameternamelist>
<parameterdescription>
<para>The mean grid box longitude in radians</para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">lat</parametername>
</parameternamelist>
<parameterdescription>
<para>The mean grid box latitude in radians</para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="out">zsurf</parametername>
</parameternamelist>
<parameterdescription>
<para>The surface height (meters). Size must be size(lon) by size(lat) </para></parameterdescription>
</parameteritem>
</parameterlist>
</para>        </detaileddescription>
