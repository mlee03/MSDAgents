        <definition>subroutine, public diag_grid_mod::diag_grid_init</definition>
        <argsstring>(domain, glo_lat, glo_lon, aglo_lat, aglo_lon)</argsstring>
        <name>diag_grid_init</name>
        <param>
          <type>domain</type>
          <defname>domain</defname>
        </param>
        <param>
          <type>glo_lat</type>
          <defname>glo_lat</defname>
