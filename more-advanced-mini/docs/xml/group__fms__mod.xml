      </memberdef>
      <memberdef kind="function" id="group__fms__mod_1gae5c7420e421293e2be14717dd7b3d97f" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>subroutine, public</type>
        <definition>subroutine, public fms_mod::error_mesg</definition>
        <argsstring>(routine, message, level)</argsstring>
        <name>error_mesg</name>
        <param>
          <type>routine</type>
          <defname>routine</defname>
        </param>
        <param>
          <type>message</type>
          <defname>message</defname>
        </param>
        <param>
          <type>level</type>
          <defname>level</defname>
        </param>
        <briefdescription>
<para>Print notes, warnings and error messages; terminates program for warning and error messages. Usage of mpp_error is preferable. (use error levels NOTE,WARNING,FATAL, see example below) </para>        </briefdescription>
        <detaileddescription>
<para>Print notes, warnings and error messages; and terminates the program for error messages. This routine is a wrapper around mpp_error, and is provided for backward compatibility. This module also publishes mpp_error, <bold>users should try to use the mpp_error interface</bold>.</para><para><linebreak/>
Example usage: <programlisting filename=".F90"><codeline><highlight class="keywordtype">use<sp/></highlight><highlight class="normal">fms_mod,<sp/></highlight><highlight class="keywordtype">only</highlight><highlight class="normal">:<sp/><ref refid="group__fms__mod_1gae5c7420e421293e2be14717dd7b3d97f" kindref="member">error_mesg</ref>,<sp/>fatal,<sp/>note</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">call<sp/></highlight><highlight class="normal"><ref refid="group__fms__mod_1gae5c7420e421293e2be14717dd7b3d97f" kindref="member">error_mesg</ref><sp/>(</highlight><highlight class="stringliteral">&apos;fms_mod&apos;</highlight><highlight class="normal">,<sp/></highlight><highlight class="stringliteral">&apos;initialization<sp/>not<sp/>called&apos;</highlight><highlight class="normal">,<sp/>fatal)</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">call<sp/></highlight><highlight class="normal"><ref refid="group__fms__mod_1gae5c7420e421293e2be14717dd7b3d97f" kindref="member">error_mesg</ref><sp/>(</highlight><highlight class="stringliteral">&apos;fms_mod&apos;</highlight><highlight class="normal">,<sp/></highlight><highlight class="stringliteral">&apos;fms_mod<sp/>message&apos;</highlight><highlight class="normal">,<sp/>note)</highlight></codeline>
</programlisting></para><para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">routine</parametername>
</parameternamelist>
<parameterdescription>
<para>Routine name where the warning or error has occurred.</para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">message</parametername>
</parameternamelist>
<parameterdescription>
<para>Warning or error message to be printed.</para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername direction="in">level</parametername>
</parameternamelist>
<parameterdescription>
<para>Level of severity; set to NOTE, WARNING, or FATAL Termination always occurs for FATAL, never for NOTE, and is settable for WARNING (see namelist). </para></parameterdescription>
</parameteritem>
</parameterlist>
</para>        </detaileddescription>
