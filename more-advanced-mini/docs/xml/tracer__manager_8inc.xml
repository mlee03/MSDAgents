        <type>subroutine</type>
        <definition>subroutine set_tracer_profile_</definition>
        <argsstring>(model, n, tracer, err_msg)</argsstring>
        <name>set_tracer_profile_</name>
        <param>
          <type>model</type>
          <defname>model</defname>
        </param>
        <param>
          <type>n</type>
          <defname>n</defname>
        </param>
        <param>
          <type>tracer</type>
          <defname>tracer</defname>
        </param>
        <param>
          <type>err_msg</type>
          <defname>err_msg</defname>
