        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername direction="in">file_unit</parametername>
</parameternamelist>
<parameterdescription>
<para>File unit number</para></parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
