        <definition>subroutine tranlon_</definition>
        <argsstring>(lon, lon_start, istrt)</argsstring>
        <name>tranlon_</name>
        <param>
          <type>lon</type>
          <defname>lon</defname>
        </param>
        <param>
          <type>lon_start</type>
